# Время жизни кэша ответов GitHub, секунд (SLO-08: не более 24 ч)
CACHE_TTL=3600

# Вход через GitHub (OAuth App): https://github.com/settings/developers → New OAuth App
#   Homepage URL:               http://localhost:5173
#   Authorization callback URL: http://localhost:5173/api/auth/callback
# Вошедший пользователь тратит свой лимит 5000/ч; гости делят анонимные
# 60 запросов/ч на IP сервера. Пусто — кнопка входа скрыта.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Ключ шифрования cookie сессии (токен пользователя хранится в ней).
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Срок жизни сессии, секунд (по умолчанию 30 дней)
SESSION_TTL=2592000
# true в проде за HTTPS
COOKIE_SECURE=false
